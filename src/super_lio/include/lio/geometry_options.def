// type, ROS key/member, default. Loaded under /lio/geometry.
GOPT(bool, enable_degeneracy, false)
GOPT(bool, enable_bump_layer, false)
GOPT(bool, enable_informed_sampling, false)
GOPT(bool, enable_bump_measurement, false)
GOPT(bool, enable_weak_selection, true)
GOPT(bool, enable_adaptive_covariance, true)
GOPT(double, degeneracy_ratio_enter_weak, 0.01)
GOPT(double, degeneracy_ratio_enter_degenerate, 0.001)
GOPT(double, degeneracy_ratio_exit_weak, 0.02)
GOPT(double, degeneracy_ratio_exit_degenerate, 0.003)
GOPT(double, degeneracy_eigen_ratio_threshold, 0.02)
GOPT(double, rotation_length_scale, 1.0)
GOPT(int, bump_capacity, 5000)
GOPT(int, bump_history_points, 512)
GOPT(int, bump_min_points, 30)
GOPT(double, bump_min_roughness, 0.002)
GOPT(double, bump_plane_ratio_max, 0.15)
GOPT(double, bump_resolution, 0.05)
GOPT(double, bump_plane_reproject_angle_deg, 5.0)
GOPT(double, bump_range_weight_max, 1.0)
GOPT(double, bump_range_epsilon, 0.1)
GOPT(double, fine_resolution, 0.1)
GOPT(double, coarse_resolution, 0.5)
GOPT(double, mid_threshold, 0.005)
GOPT(int, informed_top_k_voxels, 100)
GOPT(int, max_bump_constraints, 200)
GOPT(double, bump_min_mid, 0.003)
GOPT(double, bump_min_gradient, 0.03)
GOPT(double, bump_min_pixel_confidence, 0.1)
GOPT(double, bump_min_weak_score, 0.001)
GOPT(double, weak_direction_score_threshold, 0.001)
GOPT(double, bump_mid_scale, 0.02)
GOPT(double, bump_gradient_scale, 0.3)
GOPT(double, bump_pixel_scale, 2.0)
GOPT(double, bump_weak_scale, 0.1)
GOPT(double, bump_residual_max, 0.15)
GOPT(double, bump_huber_delta, 0.03)
GOPT(double, sigma_b_base, 0.03)
GOPT(double, sigma_b_min, 0.01)
GOPT(double, sigma_b_max, 0.3)
GOPT(double, bump_degenerate_variance_factor, 0.5)
GOPT(double, bump_max_translation_correction, 0.5)
GOPT(double, bump_max_rotation_correction, 0.15)
